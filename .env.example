# Paper Trail configuration. Copy to .env and adjust; .env is git-ignored.
# Every variable is optional: the values shown are the defaults.

# --- Docker Compose (read by compose.yaml, not by the app) -------------------------------------

# Host address the web port is published on. 127.0.0.1 = this machine only; set the server's
# LAN address (e.g. 192.168.1.10) to reach Paper Trail from your phone over LAN or WireGuard.
PAPER_TRAIL_BIND_ADDR=127.0.0.1
# Host port for the web app and API.
PAPER_TRAIL_PORT=8420
# Where /data lives: a named volume, or an absolute host directory owned by UID 1000.
PAPER_TRAIL_DATA_VOLUME=paper-trail-data
# UID/GID the dev tooling containers run as, so generated files belong to you (Makefile sets them).
#PAPER_TRAIL_UID=1000
#PAPER_TRAIL_GID=1000
# Host folder of receipt photos, mounted read-only at /receipts in the on-demand `cli` service
# (`make process`); default ./receipts (git-ignored). The path may contain spaces; do not quote it.
#PAPER_TRAIL_RECEIPTS_DIR=/path/to/your/receipts

# --- Application (PAPER_TRAIL_*, read by the app's Settings) ------------------------------------

# Environment name: dev, test or prod.
PAPER_TRAIL_ENV=prod
# Root of persistent data (database, receipt images, worker heartbeat). /data inside containers.
#PAPER_TRAIL_DATA_DIR=/data
# SQLite database file; defaults to <DATA_DIR>/paper_trail.db.
#PAPER_TRAIL_DATABASE_PATH=/data/paper_trail.db
# Log level: DEBUG, INFO, WARNING or ERROR.
PAPER_TRAIL_LOG_LEVEL=INFO
# Log format: json (one object per line) or console (human-readable).
# Unset: console when PAPER_TRAIL_ENV=dev, json otherwise.
#PAPER_TRAIL_LOG_FORMAT=json
# Address and port the HTTP server binds inside the container.
#PAPER_TRAIL_HOST=0.0.0.0
#PAPER_TRAIL_HTTP_PORT=8000
# Directory of the built web app; when missing the server runs API-only.
#PAPER_TRAIL_STATIC_DIR=/app/static
# Git SHA of the build, reported by /api/health. Set by the image; leave unset.
#PAPER_TRAIL_BUILD_SHA=

# Worker: seconds to wait between polls when there is no work (0.1 to 60).
PAPER_TRAIL_WORKER__POLL_INTERVAL_S=1.0
# Worker: seconds between heartbeat writes (the container healthcheck reads them).
PAPER_TRAIL_WORKER__HEARTBEAT_INTERVAL_S=10.0
# Worker: seconds a running step may take to finish after SIGTERM before the worker exits.
PAPER_TRAIL_WORKER__SHUTDOWN_GRACE_S=8.0

# Images: refuse images with more pixels than this (decompression-bomb guard).
PAPER_TRAIL_UPLOAD__MAX_PIXELS=40000000

# OCR (Tesseract): language of the installed language data.
PAPER_TRAIL_OCR__LANG=eng
# Tesseract page segmentation mode (0-13); 6 (one block of text) keeps the price column of a
# crumpled receipt that 4 dropped (ADR-0017).
PAPER_TRAIL_OCR__PSM=6
# Seconds one Tesseract run may take before it fails.
PAPER_TRAIL_OCR__TIMEOUT_S=30.0
# Below this mean word confidence (0-1) Tesseract also reads the photo turned 90/180/270
# degrees and keeps the most confident read (sideways phone photos); 0 turns this off.
PAPER_TRAIL_OCR__ROTATION_MIN_CONFIDENCE=0.6

# Ollama on the LLM host (two-host: the GPU PC's LAN address; single host: http://ollama:11434).
# Unset means "not configured": `paper-trail process` exits 4 without contacting anything.
#PAPER_TRAIL_OLLAMA__BASE_URL=http://192.168.0.x:11434
# Seconds the availability probe waits for the LLM host.
PAPER_TRAIL_OLLAMA__PROBE_TIMEOUT_S=2.0
# Seconds one model request may take (a cold model load counts).
PAPER_TRAIL_OLLAMA__REQUEST_TIMEOUT_S=180.0
# Text model: receipt extraction from OCR text.
PAPER_TRAIL_OLLAMA__TEXT_MODEL=qwen2.5:7b-instruct
# Vision model: re-reads the photo when the text extraction fails (agent core slice D).
PAPER_TRAIL_OLLAMA__VISION_MODEL=qwen2.5vl:7b
# Embedding model: product matching (agent core slice C).
PAPER_TRAIL_OLLAMA__EMBED_MODEL=nomic-embed-text
# How long Ollama keeps a model loaded after a request.
PAPER_TRAIL_OLLAMA__KEEP_ALIVE=5m
# Context window in tokens, sent with every request (Ollama's own default of 4096 is too small
# for the few-shot prompt plus a long receipt; one value, since changing it reloads the model).
PAPER_TRAIL_OLLAMA__NUM_CTX=8192
# Most tokens one extraction answer may take (num_predict); a model looping on a hard photo stops
# here, and the cut-off answer counts as a failed attempt (ADR-0017).
PAPER_TRAIL_OLLAMA__MAX_OUTPUT_TOKENS=4096

# Receipt graph: extraction attempts on the OCR text before a receipt goes to review (>= 1).
PAPER_TRAIL_GRAPH__MAX_TEXT_ATTEMPTS=2
# Receipt graph: reads of the photo by the vision model, after the text attempts or first on a
# poor OCR read; a retry carries only the previous vision answer's issues (0: none).
PAPER_TRAIL_GRAPH__MAX_VISION_ATTEMPTS=2
# Receipt graph: a photo whose OCR mean confidence (0-1) is below this goes to the vision model
# first, with no text attempts; 1.0 sends every photo (OCR still runs: rotation, card masking,
# the multi-buy cross-check); 0 turns this off (ADR-0017).
PAPER_TRAIL_GRAPH__VISION_FIRST_BELOW=1.0
# Receipt graph: below this model confidence (0-1) a consistent receipt still goes to review.
PAPER_TRAIL_GRAPH__MIN_CONFIDENCE=0.6
# Receipt graph: retries carry the validation issues; false sends a generic retry line (experiment E1).
PAPER_TRAIL_GRAPH__FEEDBACK=true
# Receipt graph: describe the products a receipt created (name, size, category, tags); false skips it.
PAPER_TRAIL_GRAPH__ENRICHMENT=true

# Prompt version of the extraction agent (src/paper_trail/agents/prompts/extraction/<version>/);
# v2 copies values as printed and code computes them (ADR-0017), v1 answers integer cents.
PAPER_TRAIL_PROMPTS__EXTRACTION_VERSION=v2
# Prompt version of the vision attempt (src/paper_trail/agents/prompts/vision/<version>/).
PAPER_TRAIL_PROMPTS__VISION_VERSION=v1
# Prompt version of the matching agent (agent core slice C).
PAPER_TRAIL_PROMPTS__MATCHING_VERSION=v1
# Prompt version of the enrichment agent (agent core slice D).
PAPER_TRAIL_PROMPTS__ENRICHMENT_VERSION=v1
# Include the few-shot examples in prompts (false: experiment E1's optional arm).
PAPER_TRAIL_PROMPTS__EXAMPLES=true

# Matching (cosine distance between embeddings, 0 = same direction): the nearest product at most
# this far is linked to a receipt line without asking.
PAPER_TRAIL_MATCHING__AUTO_LINK_MAX_DISTANCE=0.15
# Matching: further than the above but at most this far, the text model confirms the product
# among the three nearest; further still is a new product. Not below the auto-link distance.
PAPER_TRAIL_MATCHING__REVIEW_MAX_DISTANCE=0.30

# Tools: how the agents call them, inprocess or mcp. With mcp, `paper-trail process` serves its
# run's tools over MCP on a loopback port itself; `paper-trail tools` uses PAPER_TRAIL_MCP__URL.
PAPER_TRAIL_TOOLS__TRANSPORT=inprocess
# MCP: the standalone tool server (`make mcp-up`); inside compose it is the `mcp` service.
PAPER_TRAIL_MCP__URL=http://mcp:8000
# MCP: seconds one tool call may take, connecting included, before the server counts as unreachable.
# Must be greater than the OCR worst case (PAPER_TRAIL_OCR__TIMEOUT_S x 4 Tesseract runs while
# PAPER_TRAIL_OCR__ROTATION_MIN_CONFIDENCE > 0, else x 1) and PAPER_TRAIL_OLLAMA__REQUEST_TIMEOUT_S:
# a call waits for its tool (ocr_read for Tesseract, the matching tools for the embedding model).
PAPER_TRAIL_MCP__TIMEOUT_S=240.0
