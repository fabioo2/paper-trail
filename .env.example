# Paper Trail configuration. Copy to .env and adjust; .env is git-ignored.
# Every variable is optional: the values shown are the defaults.

# --- Docker Compose (read by compose.yaml, not by the app) -------------------------------------

# Host address the web port is published on. 127.0.0.1 = this machine only; set the server's
# LAN address (e.g. 192.168.1.10) to reach Paper Trail from your phone over LAN or WireGuard.
PAPER_TRAIL_BIND_ADDR=127.0.0.1
# Host port for the web app and API.
PAPER_TRAIL_PORT=8420
# Where /data lives: a named volume, or an absolute host directory owned by UID 1000.
PAPER_TRAIL_DATA_VOLUME=paper-trail-data
# UID/GID the dev tooling containers run as, so generated files belong to you (Makefile sets them).
#PAPER_TRAIL_UID=1000
#PAPER_TRAIL_GID=1000
# Host folder of receipt photos, mounted read-only at /receipts in the on-demand `cli` service
# (`make process`); default ./receipts (git-ignored). The path may contain spaces; do not quote it.
#PAPER_TRAIL_RECEIPTS_DIR=/path/to/your/receipts

# --- Application (PAPER_TRAIL_*, read by the app's Settings) ------------------------------------

# Environment name: dev, test or prod.
PAPER_TRAIL_ENV=prod
# Root of persistent data (database, receipt images, worker heartbeat). /data inside containers.
#PAPER_TRAIL_DATA_DIR=/data
# SQLite database file; defaults to <DATA_DIR>/paper_trail.db.
#PAPER_TRAIL_DATABASE_PATH=/data/paper_trail.db
# Log level: DEBUG, INFO, WARNING or ERROR.
PAPER_TRAIL_LOG_LEVEL=INFO
# Log format: json (one object per line) or console (human-readable).
# Unset: console when PAPER_TRAIL_ENV=dev, json otherwise.
#PAPER_TRAIL_LOG_FORMAT=json
# Address and port the HTTP server binds inside the container.
#PAPER_TRAIL_HOST=0.0.0.0
#PAPER_TRAIL_HTTP_PORT=8000
# Directory of the built web app; when missing the server runs API-only.
#PAPER_TRAIL_STATIC_DIR=/app/static
# Git SHA of the build, reported by /api/health. Set by the image; leave unset.
#PAPER_TRAIL_BUILD_SHA=

# Worker: seconds to wait between polls when there is no work (0.1 to 60).
PAPER_TRAIL_WORKER__POLL_INTERVAL_S=1.0
# Worker: seconds between heartbeat writes (the container healthcheck reads them).
PAPER_TRAIL_WORKER__HEARTBEAT_INTERVAL_S=10.0
# Worker: seconds a running step may take to finish after SIGTERM before the worker exits; long
# enough for one Claude read. Keep compose's worker stop_grace_period (100s) above it.
PAPER_TRAIL_WORKER__SHUTDOWN_GRACE_S=90.0

# Web: host names or IPs the app is reached by, comma-separated, besides localhost, 127.0.0.1,
# ::1 and web (always served); any other Host header is refused (ADR-0020). No scheme or port.
#PAPER_TRAIL_WEB__ALLOWED_HOSTS=192.168.1.10,my-server

# Uploads: refuse a file larger than this many bytes (413).
PAPER_TRAIL_UPLOAD__MAX_BYTES=15000000

# Images: refuse images with more pixels than this (decompression-bomb guard).
PAPER_TRAIL_UPLOAD__MAX_PIXELS=40000000

# Claude reads every receipt photo (claude-extraction plan). The whole photo is sent to
# Anthropic: whatever it shows (card digits as the terminal printed them, the store, a loyalty
# id, sometimes a name) leaves this machine. The key is the SDK's own variable, without the
# PAPER_TRAIL_ prefix; without it the app starts, and a receipt that needs Claude fails with a
# message naming this variable.
ANTHROPIC_API_KEY=
# Model of the first read of a receipt.
PAPER_TRAIL_CLAUDE__EXTRACT_MODEL=claude-haiku-5-5
# Model of the one retry, when the first read does not add up (it gets the failures listed).
PAPER_TRAIL_CLAUDE__RETRY_MODEL=claude-opus-5-5
# Seconds one Claude request may take; a read makes up to three (a rate limit, an overloaded
# API, a lost connection or a timeout is retried). The retry model can take minutes to write a
# long answer; a request given up on here is still billed.
PAPER_TRAIL_CLAUDE__TIMEOUT_S=300
# Spending cap per UTC calendar month, in USD, checked before each call: once reached, receipts
# fail (resumable) until the cap is raised or the month ends. 0 stops every call.
PAPER_TRAIL_CLAUDE__MONTHLY_BUDGET_USD=5.00

# Receipt graph: Claude reads per receipt before it goes to review (1 or 2: the retry model).
PAPER_TRAIL_GRAPH__MAX_ATTEMPTS=2
# Receipt graph: retries carry the validation issues; false sends a generic retry line (experiment E1).
PAPER_TRAIL_GRAPH__FEEDBACK=true
# Receipt graph: describe the products a receipt created: from the catalog entry that named
# them (PLU), then the product databases below for a barcode, else Claude guesses them (with the
# extract model, counted in the monthly budget; a guess is marked unconfirmed until
# `catalog confirm`). False skips the whole stage.
PAPER_TRAIL_GRAPH__ENRICHMENT=true

# Product databases asked for a barcode (only the barcode is sent). Open Food Facts, then Open
# Beauty Facts and Open Products Facts (no key; data under the ODbL, see the README).
PAPER_TRAIL_LOOKUP__OPEN_FACTS=true
# UPCitemdb's free trial endpoint (100 requests a day), asked last. Off by default: its terms do
# not clearly allow keeping its answers; its answers are never sent to Claude.
PAPER_TRAIL_LOOKUP__UPCITEMDB=false
# Seconds one product-database request may take (up to 60).
PAPER_TRAIL_LOOKUP__TIMEOUT_S=10

# Prompt version of the extraction agent (src/paper_trail/agents/prompts/extraction/<version>/).
PAPER_TRAIL_PROMPTS__EXTRACTION_VERSION=v3

# Catalog: match a line that starts with a product code by that code (false: by its text, as a
# line without a code; `process --no-catalog` for one run). No model is asked either way.
PAPER_TRAIL_CATALOG__ENABLED=true
# Catalog: the PLU table (code,name,organic); a missing file is a miss. Default:
# <PAPER_TRAIL_DATA_DIR>/catalog/plu.csv
# PAPER_TRAIL_CATALOG__PLU_PATH=

# Tools: how the agents call them, inprocess or mcp. With mcp, `paper-trail process` serves its
# run's tools over MCP on a loopback port itself; `paper-trail tools` uses PAPER_TRAIL_MCP__URL.
PAPER_TRAIL_TOOLS__TRANSPORT=inprocess
# MCP: the standalone tool server (`make mcp-up`); inside compose it is the `mcp` service.
PAPER_TRAIL_MCP__URL=http://mcp:8000
# MCP: seconds one tool call may take, connecting included, before the server counts as unreachable.
# Must be greater than PAPER_TRAIL_CLAUDE__TIMEOUT_S.
PAPER_TRAIL_MCP__TIMEOUT_S=330.0
