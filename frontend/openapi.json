{
  "components": {
    "schemas": {
      "ArithmeticIssueOut": {
        "properties": {
          "actual": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "$ref": "#/components/schemas/IssueCode"
          },
          "expected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          }
        },
        "required": [
          "code",
          "message",
          "expected",
          "actual",
          "position"
        ],
        "title": "ArithmeticIssueOut",
        "type": "object"
      },
      "ArithmeticReportOut": {
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ArithmeticIssueOut"
            },
            "title": "Issues",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "issues"
        ],
        "title": "ArithmeticReportOut",
        "type": "object"
      },
      "Category": {
        "enum": [
          "produce",
          "meat_seafood",
          "dairy_eggs",
          "bakery",
          "deli_prepared",
          "pantry",
          "frozen",
          "beverages",
          "snacks_candy",
          "alcohol",
          "household",
          "personal_care",
          "health_pharmacy",
          "baby",
          "pet",
          "electronics",
          "clothing",
          "home_garden",
          "automotive_fuel",
          "restaurant",
          "services",
          "other"
        ],
        "title": "Category",
        "type": "string"
      },
      "CategoryOut": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "title": "CategoryOut",
        "type": "object"
      },
      "ComponentOut": {
        "properties": {
          "data": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Data",
            "type": "object"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "name",
          "status",
          "detail",
          "data"
        ],
        "title": "ComponentOut",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "build_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Sha"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "build_sha"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "degraded",
          "error"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "IssueCode": {
        "enum": [
          "line_math",
          "items_vs_subtotal",
          "subtotal_plus_tax_vs_total",
          "items_plus_tax_vs_total",
          "negative_item",
          "currency_mismatch",
          "empty_receipt",
          "missing_store",
          "missing_date"
        ],
        "title": "IssueCode",
        "type": "string"
      },
      "LineItemOut": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/LineKind"
          },
          "line_total": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "raw_text": {
            "title": "Raw Text",
            "type": "string"
          },
          "unit_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "position",
          "kind",
          "raw_text",
          "description",
          "quantity",
          "unit_price",
          "line_total",
          "product_id",
          "category"
        ],
        "title": "LineItemOut",
        "type": "object"
      },
      "LineKind": {
        "description": "What a receipt line is. Only DISCOUNT lines carry negative totals.",
        "enum": [
          "item",
          "discount",
          "deposit",
          "fee"
        ],
        "title": "LineKind",
        "type": "string"
      },
      "MoneyOut": {
        "properties": {
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_cents",
          "currency"
        ],
        "title": "MoneyOut",
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "errors"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ProcessingStage": {
        "description": "Where a receipt is in the pipeline; reported live from Stage 2 (SSE).",
        "enum": [
          "queued",
          "waiting_for_gpu",
          "reading",
          "extracting",
          "validating",
          "matching",
          "enriching",
          "saving",
          "done",
          "needs_review",
          "failed"
        ],
        "title": "ProcessingStage",
        "type": "string"
      },
      "ReadinessOut": {
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentOut"
            },
            "title": "Components",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "title": "ReadinessOut",
        "type": "object"
      },
      "ReceiptDetailOut": {
        "properties": {
          "arithmetic": {
            "$ref": "#/components/schemas/ArithmeticReportOut"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "has_image": {
            "title": "Has Image",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "item_count": {
            "title": "Item Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LineItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "payment_last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Last4"
          },
          "purchased_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased On"
          },
          "stage": {
            "$ref": "#/components/schemas/ProcessingStage"
          },
          "status": {
            "$ref": "#/components/schemas/ReceiptStatus"
          },
          "store_name": {
            "title": "Store Name",
            "type": "string"
          },
          "subtotal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "tax": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "store_name",
          "purchased_on",
          "total",
          "item_count",
          "created_at",
          "stage",
          "subtotal",
          "tax",
          "payment_last4",
          "has_image",
          "items",
          "arithmetic"
        ],
        "title": "ReceiptDetailOut",
        "type": "object"
      },
      "ReceiptPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReceiptSummaryOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ReceiptPageOut",
        "type": "object"
      },
      "ReceiptStatus": {
        "enum": [
          "processing",
          "needs_review",
          "completed",
          "failed"
        ],
        "title": "ReceiptStatus",
        "type": "string"
      },
      "ReceiptSummaryOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "item_count": {
            "title": "Item Count",
            "type": "integer"
          },
          "purchased_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased On"
          },
          "status": {
            "$ref": "#/components/schemas/ReceiptStatus"
          },
          "store_name": {
            "title": "Store Name",
            "type": "string"
          },
          "total": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "store_name",
          "purchased_on",
          "total",
          "item_count",
          "created_at"
        ],
        "title": "ReceiptSummaryOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Paper Trail",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/categories": {
      "get": {
        "description": "Every product category with its display label, in a stable order.",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryOut"
                  },
                  "title": "Response Listcategories",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List categories",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "The process is up. Touches no database or other dependency.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "description": "Every component is usable. Answers 503 with the same body when one is not.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "A component is not ready; the body says which and why."
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/receipts": {
      "get": {
        "description": "Receipts newest first. A bad cursor or limit is a 422 problem.",
        "operationId": "listReceipts",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "next_cursor of the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_cursor of the previous page",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ReceiptStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "description": "Store name, in any spelling",
            "in": "query",
            "name": "store",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store name, in any spelling",
              "title": "Store"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptPageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List receipts",
        "tags": [
          "receipts"
        ]
      }
    },
    "/api/receipts/{receipt_id}": {
      "get": {
        "description": "One receipt with its lines and an arithmetic report computed from the current data.",
        "operationId": "getReceipt",
        "parameters": [
          {
            "in": "path",
            "name": "receipt_id",
            "required": true,
            "schema": {
              "title": "Receipt Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get a receipt",
        "tags": [
          "receipts"
        ]
      }
    }
  }
}
