# LLM host settings. Copy to deploy/llm/.env on the GPU PC; .env is git-ignored.

# Address Ollama's port 11434 is published on. 127.0.0.1 = this PC only. Set the PC's LAN
# address (e.g. 192.168.1.20) so the app host can reach it, and firewall the port to the app
# host's IP (see README, "LLM host").
OLLAMA_BIND_ADDR=127.0.0.1

# How long an idle model stays loaded in VRAM.
OLLAMA_KEEP_ALIVE=5m

# Models pulled by `ollama-init`; keep them in sync with the app host's .env.
# Text extraction and validation (PAPER_TRAIL_OLLAMA__TEXT_MODEL).
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
# Vision re-read fallback (PAPER_TRAIL_OLLAMA__VISION_MODEL).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Embeddings for product matching and search (PAPER_TRAIL_OLLAMA__EMBED_MODEL).
OLLAMA_EMBED_MODEL=nomic-embed-text
